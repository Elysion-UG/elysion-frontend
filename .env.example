# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# Backend API URL (client-side)
# Leave empty for relative paths (recommended with subdomains — keeps requests same-origin).
# Only set for direct backend access without Next.js proxy:
#   http://localhost:8080  or  https://elysion-backend-stage.onrender.com
NEXT_PUBLIC_API_URL=

# Backend API URL (server-side) — REQUIRED in any deployed environment.
# Used by:
#   - next.config.mjs rewrites: proxies /api/v1/* to the backend (same-origin).
#     When unset, NO rewrite is registered → /api/v1/* on this origin returns 404.
#   - src/app/api/v1/auth/[...path]/route.ts: the auth proxy that round-trips the
#     HttpOnly refresh cookie. When unset, resolveBackendUrl() THROWS in production
#     → every login returns HTTP 500.
# In production this MUST be set (the code throws if it is missing); locally it
# falls back to http://localhost:8080.
#   e.g. https://elysion-backend-stage.onrender.com
API_URL=

# Backend host for image remotePatterns + CSP img-src/connect-src (no protocol, no path).
# Defaults to the staging backend (see src/lib/constants/backend-host.mjs) when unset.
# Set to your backend host in production, e.g. api.yourdomain.com
NEXT_PUBLIC_BACKEND_HOST=

# Stripe publishable key (client-side, REQUIRED for checkout payments)
# Without it the checkout shows "Zahlungssystem nicht konfiguriert" and payment is disabled
# (PaymentStep.tsx: stripePromise stays null when this is empty).
# Use a test key (pk_test_...) for local/dev, a live key (pk_live_...) in production.
# This is the PUBLISHABLE key only — never put the secret key (sk_...) in the frontend.
# Get it from: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Shared secret for the auth proxy → backend client-IP forwarding (server-side only).
# When set, the auth proxy (/api/v1/auth/[...path]) sends the Vercel-verified client IP
# as X-Client-IP together with X-Auth-Proxy-Secret. The backend only trusts that IP for
# login rate limiting when the secret matches APP_AUTH_RATE_LIMIT_TRUSTED_PROXY_SECRET
# on the backend (see backend#149). Leave empty for local dev.
# NOTE: if unset on a deployed environment, the backend ignores X-Client-IP and
# rate-limits on its own resolved remote address — for traffic through this proxy
# that is the shared Vercel egress IP, so legitimate users may collide.
# Generate with: openssl rand -base64 32
AUTH_PROXY_SECRET=

# Support email — the contact form opens the user's mail client addressed here.
# Defaults to support@elysion.de if unset. Set to the real support address.
NEXT_PUBLIC_SUPPORT_EMAIL=support@elysion.de

# Seller portal domain
# Dev:  seller.localhost:3000
# Prod: seller.yourdomain.com

# Server-side: middleware redirects /seller-dashboard on main domain to seller domain
SELLER_DOMAIN=seller.localhost:3000

# Client-side: SellerLogin redirects directly to seller domain after login
NEXT_PUBLIC_SELLER_DOMAIN=seller.localhost:3000

# Admin portal domain
# Dev:  admin.localhost:3000
# Prod: admin.yourdomain.com

# Server-side: middleware redirects /admin on main domain to admin domain
ADMIN_DOMAIN=admin.localhost:3000

# Client-side: AdminLogin redirects directly to admin domain after login
NEXT_PUBLIC_ADMIN_DOMAIN=admin.localhost:3000

# Client-side: buyer (main shop) domain — used to redirect back from seller/admin portal
NEXT_PUBLIC_BUYER_DOMAIN=localhost:3000

# Server-side: middleware redirects non-portal paths back to buyer domain
BUYER_DOMAIN=localhost:3000
